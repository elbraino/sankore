{
  "name": "sankore",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "validate": "bash scripts/validate.sh",
    "build": "npm run validate && astro build",
    "postbuild": "pagefind --site dist && python3 scripts/check_spacing.py dist",
    "preview": "astro preview",
    "check": "astro check",
    "setup:py": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt"
  },
  "dependencies": {
    "astro": "^7.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.0"
  }
}
