---
/**
 * "This entry's source of truth" — a link to the YAML file behind the page.
 *
 * CLAUDE.md: "The repo IS the database." What a visitor reads here is a
 * projection of one file; this makes that file one click away, so a reader can
 * check exactly what is recorded, see its `# Source:` provenance comment and
 * its full history, and open a correction against it.
 */
import { dataFileUrl } from "../../site.config.ts";

interface Props {
  kind: "people" | "works" | "events";
  slug: string;
}

const { kind, slug } = Astro.props;
const href = dataFileUrl(kind, slug);
const filename = `data/${kind}/${slug}.yaml`;
---

<p class="source-link">
  <svg aria-hidden="true" viewBox="0 0 16 16" width="13" height="13">
    <path
      fill="currentColor"
      d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33C3.8 14.31 3.34 12.85 3.34 12.85c-.36-.92-.88-1.16-.88-1.16-.72-.49.05-.48.05-.48.8.06 1.22.82 1.22.82.71 1.21 1.86.86 2.31.66.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.01.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.11.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.19c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"
    ></path>
  </svg>
  <span>
    Source of truth:
    <a href={href} rel="noopener external"><code>{filename}</code></a>
  </span>
</p>

<style>
  .source-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    margin-block: var(--space-md) 0;
    font-family: var(--face-mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .source-link svg {
    flex: none;
    align-self: center;
  }

  .source-link code {
    font-size: inherit;
    word-break: break-all;
  }
</style>
