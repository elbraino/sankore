---
import BaseLayout from "../layouts/BaseLayout.astro";
import { countryName, loadArchive, UNKNOWN_COUNTRY, WORK_TYPE_LABELS } from "../lib/atlas";

/*
 * Coverage, not a scoreboard.
 *
 * CLAUDE.md is explicit: no rankings, no scores, no leaderboards, ever. That
 * rule is about people, and it is why nothing here aggregates per person —
 * there is deliberately no "most works" table, and adding one later would
 * break the rule even though the data trivially allows it.
 *
 * What IS here is coverage: how much of the region, of the timeline, and of
 * the record this archive actually holds. Every section is built to be read
 * as "where is this thin?" rather than "who is ahead?", and the gaps section
 * exists so the holes are as visible as the contents. An archive that hides
 * what it is missing is making a claim it has not earned.
 */
const { works, people, events } = await loadArchive();

const total = works.length;

/** Count into a map, skipping empties. */
function tally<T>(items: T[], key: (item: T) => string | undefined): Map<string, number> {
  const counts = new Map<string, number>();
  for (const item of items) {
    const k = key(item);
    if (!k) continue;
    counts.set(k, (counts.get(k) ?? 0) + 1);
  }
  return counts;
}

// ── Timeline ───────────────────────────────────────────────────────────────
// Every year between the first and last entry is rendered, including the empty
// ones. A chart that silently omits 2014 reads as "nothing happened in 2014"
// when the truth is "nothing is indexed for 2014" — a different claim.
const years = works.map((w) => w.entry.data.year);
const firstYear = Math.min(...years);
const lastYear = Math.max(...years);
const byYear = tally(works, (w) => String(w.entry.data.year));
const timeline = Array.from({ length: lastYear - firstYear + 1 }, (_, i) => {
  const year = firstYear + i;
  return { year, count: byYear.get(String(year)) ?? 0 };
});
const peakYear = Math.max(...timeline.map((t) => t.count));

// ── Region ─────────────────────────────────────────────────────────────────
// `country` on a work is the resolved REGION (see workCountry in lib/atlas):
// an author's stated country first, else the venue's. Unattributed entries are
// shown rather than dropped, because how much is unattributed is itself the
// most useful number on this page.
const byRegion = Array.from(tally(works, (w) => w.country).entries())
  .map(([code, count]) => ({
    code,
    name: code === UNKNOWN_COUNTRY ? "Unattributed" : countryName(code),
    count,
  }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
const regionsRepresented = byRegion.filter((r) => r.code !== UNKNOWN_COUNTRY).length;

// ── Type ───────────────────────────────────────────────────────────────────
const byType = Array.from(tally(works, (w) => w.entry.data.type).entries())
  .map(([type, count]) => ({ label: WORK_TYPE_LABELS[type] ?? type, count }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

// ── What the record is missing ─────────────────────────────────────────────
const has = (fn: (w: (typeof works)[number]) => unknown) => works.filter((w) => fn(w)).length;
const completeness = [
  {
    label: "Have an abstract",
    n: has((w) => w.entry.data.abstract),
    note: "Quoted verbatim from the source; never written by us.",
  },
  {
    label: "Link to the work itself",
    n: has((w) => w.entry.data.links && Object.keys(w.entry.data.links).length > 0),
    note: "A recording, deck, repo, paper or advisory.",
  },
  {
    label: "Cite the page they came from",
    n: has((w) => w.entry.data.source),
    note: "Provenance, so any entry can be checked against its origin.",
  },
  {
    label: "Have an archived mirror",
    n: has((w) => w.entry.data.links?.archive),
    note: "Regional conference sites go dark often.",
  },
];

const eventsWithWorks = events.filter((e) => e.workCount > 0).length;
const eventsEmpty = events.length - eventsWithWorks;
const peopleWithCountry = people.filter((p) => p.entry.data.country).length;
const claimed = people.filter((p) => p.entry.data.claimed).length;

const pct = (n: number, of: number) => (of === 0 ? 0 : Math.round((n / of) * 100));

const description =
  "How much of the region, the timeline, and the public record this index actually holds — including where it is thin.";
---

<BaseLayout title="Coverage" description={description}>
  <article class="page stats">
    <header class="page-head">
      <p class="label">Index · Coverage</p>
      <h1>Coverage</h1>
      <p class="prose lede">
        What this archive holds, and where it is thin. Counts are generated from the repository
        at build time, so this page is never staler than the data behind it.
      </p>
    </header>

    <dl class="glance">
      <div><dt>Works</dt><dd>{total}</dd></div>
      <div><dt>Researchers</dt><dd>{people.length}</dd></div>
      <div><dt>Events</dt><dd>{events.length}</dd></div>
      <div><dt>Countries</dt><dd>{regionsRepresented}</dd></div>
    </dl>

    <div class="meridian"></div>

    <section class="block">
      <h2>By year</h2>
      <p class="prose block-note">
        {firstYear}–{lastYear}. Empty years are drawn rather than skipped — a missing bar means
        nothing is <em>indexed</em> for that year, which is not the same as nothing happening.
      </p>
      <ol class="timeline" role="list">
        {
          timeline.map((t) => (
            <li class:list={["timeline-year", t.count === 0 && "is-empty"]}>
              {/*
                A unitless fraction, not a percentage: the bar's height is
                calc()'d against a real length below. A percentage block-size
                would resolve against the flex row's indefinite height and
                collapse every bar to its minimum.
              */}
              <span
                class="timeline-bar"
                aria-hidden="true"
                style={`--fill:${peakYear === 0 ? 0 : t.count / peakYear}`}
              />
              <span class="timeline-count">{t.count}</span>
              {/* Apostrophe-prefixed so a two-digit year cannot be misread as
                  the count sitting directly above it. */}
              <span class="timeline-label">’{String(t.year).slice(2)}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="block">
      <h2>By region</h2>
      <p class="prose block-note">
        A work's region is its first author's stated country, or failing that the country of the
        event it was presented at. It is never inferred from anybody's name.
      </p>
      <ul class="bars" role="list">
        {
          byRegion.map((r) => (
            <li class:list={["bar-row", r.code === UNKNOWN_COUNTRY && "is-unknown"]}>
              <span class="bar-key">
                <span class="plate bar-code">{r.code}</span>
                <span class="bar-name">{r.name}</span>
              </span>
              <span class="bar-track" aria-hidden="true">
                <span class="bar-fill" style={`--fill:${pct(r.count, total)}%`} />
              </span>
              <span class="bar-value">{r.count}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block">
      <h2>By kind</h2>
      <ul class="tag-list" role="list">
        {byType.map((t) => <li class="tag">{t.label} · {t.count}</li>)}
      </ul>
    </section>

    <section class="block">
      <h2>What the record is missing</h2>
      <p class="prose block-note">
        The archive is only as good as what can be checked. These are counted out of
        {" "}{total} works, and the shortfalls are the work still to do.
      </p>
      <ul class="bars" role="list">
        {
          completeness.map((c) => (
            <li class="bar-row">
              <span class="bar-key">
                <span class="bar-name">{c.label}</span>
                <span class="bar-note">{c.note}</span>
              </span>
              <span class="bar-track" aria-hidden="true">
                <span class="bar-fill" style={`--fill:${pct(c.n, total)}%`} />
              </span>
              <span class="bar-value">
                {c.n}<span class="bar-of">/{total}</span>
              </span>
            </li>
          ))
        }
      </ul>

      <ul class="gaps" role="list">
        <li>
          <strong>{eventsEmpty}</strong> of {events.length} events have no indexed work yet —
          the largest single gap. <a href="/events/">See the landscape</a>.
        </li>
        <li>
          <strong>{people.length - peopleWithCountry}</strong> of {people.length} researchers have
          no country recorded. Country is optional, stated-only, and never inferred, so this
          number is expected to stay high.
        </li>
        <li>
          <strong>{claimed}</strong> {claimed === 1 ? "profile has" : "profiles have"} been claimed.
          Entries stay minimal until the person claims them. <a href="/contribute/">How claiming works</a>.
        </li>
      </ul>
    </section>

    <p class="not-a-ranking">
      An archive, not a ranking. Nothing here is counted per person, and nothing here is a
      measure of anyone's worth — only of how much of the public record has been gathered.
    </p>
  </article>
</BaseLayout>

<style>
  .page-head {
    margin-block-end: var(--space-lg);
  }

  .lede {
    margin-block-start: var(--space-sm);
  }

  /* Four figures, the page's headline. Collapses to two columns before it
     collapses to one, so the numbers stay comparable at a glance. */
  .glance {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    margin: 0;
  }

  .glance div {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-2xs);
  }

  .glance dt {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .glance dd {
    margin: 0;
    font-family: var(--face-mono);
    font-size: var(--text-3xl);
    font-variant-numeric: tabular-nums;
    line-height: var(--leading-tight);
    color: var(--ink);
  }

  .block {
    margin-block-start: var(--space-xl);
  }

  .block h2 {
    font-size: var(--text-xl);
  }

  .block-note {
    margin-block: var(--space-2xs) var(--space-md);
    max-inline-size: var(--measure);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  /* ── Timeline ─────────────────────────────────────────────────────────── */
  .timeline {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    padding-block-end: var(--space-2xs);
  }

  .timeline-year {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
    min-inline-size: 1.6rem;
  }

  /* --fill is a 0–1 fraction of the peak year, scaled against a fixed length so
     the height does not depend on the flex row resolving one. The 2px floor
     keeps a zero year visible as a baseline tick rather than nothing at all. */
  .timeline-bar {
    inline-size: 100%;
    block-size: calc(2px + var(--fill) * 9rem);
    background: var(--data);
    border-radius: 1px 1px 0 0;
  }

  .is-empty .timeline-bar {
    background: var(--rule);
  }

  .timeline-count {
    font-family: var(--face-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
  }

  .is-empty .timeline-count {
    color: var(--ink-faint);
  }

  .timeline-label {
    font-family: var(--face-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-plate);
    color: var(--ink-faint);
  }

  /* ── Horizontal bars ──────────────────────────────────────────────────── */
  .bars {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bar-row {
    display: grid;
    grid-template-columns: minmax(0, 14rem) 1fr auto;
    align-items: center;
    gap: var(--space-sm);
    padding-block: var(--space-2xs);
    border-block-start: var(--hairline) solid var(--rule);
  }

  .bar-key {
    display: flex;
    flex-direction: column;
    gap: 0.1em;
    min-inline-size: 0;
  }

  .bar-code {
    align-self: start;
  }

  .bar-name {
    font-size: var(--text-sm);
    color: var(--ink);
  }

  .bar-note {
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .bar-track {
    block-size: 0.5rem;
    background: var(--data-surface);
    border-radius: 1px;
  }

  .bar-fill {
    display: block;
    inline-size: var(--fill);
    min-inline-size: 2px;
    block-size: 100%;
    background: var(--data);
    border-radius: 1px;
  }

  /* Unattributed is a gap, not a region — drawn in the rule colour so it never
     reads as another country's share. */
  .is-unknown .bar-fill {
    background: var(--rule-strong);
  }

  .is-unknown .bar-name {
    color: var(--ink-muted);
  }

  .bar-value {
    font-family: var(--face-mono);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .bar-of {
    color: var(--ink-faint);
  }

  /* ── Gaps ─────────────────────────────────────────────────────────────── */
  .gaps {
    margin-block-start: var(--space-md);
    padding-inline-start: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .gaps li {
    max-inline-size: var(--measure);
    padding-inline-start: var(--space-sm);
    border-inline-start: 2px solid var(--gold-rule);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .gaps strong {
    font-family: var(--face-mono);
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .not-a-ranking {
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-md);
    border-block-start: var(--hairline) solid var(--rule);
    max-inline-size: var(--measure);
    font-size: var(--text-sm);
    color: var(--ink-faint);
  }

  @media (max-width: 46rem) {
    .glance {
      grid-template-columns: repeat(2, 1fr);
    }

    .bar-row {
      grid-template-columns: 1fr auto;
    }

    /* The track spans the full width under its label rather than being crushed
       into a few pixels. */
    .bar-track {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  @media (max-width: 32rem) {
    .glance dd {
      font-size: var(--text-2xl);
    }
  }
</style>
