---
import BaseLayout from "../layouts/BaseLayout.astro";
import { countryName, loadArchive, WORK_TYPE_LABELS } from "../lib/atlas";
import { SITE_NAME, SITE_TAGLINE } from "../../site.config.ts";

const { works, people, events } = await loadArchive();

const recent = works
  .slice()
  .sort(
    (a, b) =>
      b.entry.data.year - a.entry.data.year ||
      (b.entry.data.added?.getTime() ?? 0) - (a.entry.data.added?.getTime() ?? 0),
  )
  .slice(0, 8);

// Region entry points: countries ranked by how much of the archive they hold.
// This orders PLACES, never people — the rankings ban is about researchers.
const countryCounts = new Map<string, number>();
for (const work of works) {
  countryCounts.set(work.country, (countryCounts.get(work.country) ?? 0) + 1);
}
for (const event of events) {
  countryCounts.set(event.country, (countryCounts.get(event.country) ?? 0) + 1);
}
const regions = Array.from(countryCounts.entries())
  .map(([code, count]) => ({ code, name: countryName(code), count }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name))
  .slice(0, 12);
---

<BaseLayout title={SITE_NAME} description={SITE_TAGLINE}>
  <section class="hero page">
    <p class="label">Arab world &amp; Africa</p>
    <h1 class="hero-title">{SITE_TAGLINE}</h1>
    <p class="hero-body prose">
      Conference talks, released tools, assigned CVEs, papers, and write-ups —
      collected in one place, with the researchers credited on their own terms.
      An archive, not a ranking: no scores, no leaderboards, no "top researchers".
    </p>

    <p class="hero-actions">
      <a class="hero-button" href="/works/">Browse the index</a>
      <a href="/contribute/">Add a work</a>
    </p>

    <dl class="hero-stats">
      <div>
        <dt>Works</dt>
        <dd>{works.length}</dd>
      </div>
      <div>
        <dt>Researchers</dt>
        <dd>{people.length}</dd>
      </div>
      <div>
        <dt>Events</dt>
        <dd>{events.length}</dd>
      </div>
    </dl>
  </section>

  <div class="page"><div class="meridian"></div></div>

  <section class="page recent">
    <div class="section-head">
      <h2 class="label">Plate I · Recently indexed</h2>
      <a class="section-more" href="/works/">All works →</a>
    </div>

    {
      recent.length === 0 ? (
        <p class="empty">Nothing indexed yet. <a href="/contribute/">Be first.</a></p>
      ) : (
        <ol class="atlas-plate">
          {recent.map((work) => (
            <li class="atlas-entry">
              <span class="plate atlas-entry-ref">{work.plate}</span>
              <span class="atlas-entry-body">
                <a class="atlas-entry-title" href={`/works/${work.entry.id}/`}>
                  {work.entry.data.title}
                </a>
                <span class="atlas-entry-meta">
                  {[
                    work.authors.map((a) => a.data.name).join(", "),
                    work.event?.data.name,
                    WORK_TYPE_LABELS[work.entry.data.type],
                  ]
                    .filter(Boolean)
                    .join(" · ")}
                </span>
              </span>
              <span class="atlas-entry-year">{work.entry.data.year}</span>
            </li>
          ))}
        </ol>
      )
    }
  </section>

  <section class="page regions">
    <div class="section-head">
      <h2 class="label">Plate II · Entry points</h2>
      <a class="section-more" href="/events/">Event landscape →</a>
    </div>

    <ul class="region-grid">
      {
        regions.map((region) => (
          <li>
            <a class="region-tile" href={`/works/?country=${region.code}`}>
              <span class="region-tile-code">{region.code}</span>
              <span class="region-tile-name">{region.name}</span>
              <span class="region-tile-count">{region.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page consent-note">
    <div class="meridian"></div>
    <div class="consent-inner prose">
      <h2 class="label">How people are listed</h2>
      <p>
        Work is public record and is indexed by default. People are not. A
        researcher's entry shows only their name, an optional country, and their
        linked works until they choose to claim it — and any entry can be
        removed on request, without justification and without debate.
      </p>
      <p>
        <a href="/about/#consent">Read the consent model</a> ·
        <a href="/about/#removal">Request removal</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block-end: var(--space-xl);
  }

  .hero-title {
    max-inline-size: 20ch;
    margin-block-end: var(--space-md);
  }

  .hero-body {
    font-size: var(--text-lg);
    color: var(--ink-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    margin-block: var(--space-lg);
  }

  .hero-button {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    background: var(--action);
    color: var(--paper);
    font-family: var(--face-mono);
    letter-spacing: var(--tracking-plate);
    padding: var(--space-xs) var(--space-lg);
    border-radius: var(--radius);
    text-decoration: none;
    transition: background-color var(--duration) var(--ease);
  }

  .hero-button:hover {
    background: var(--action-hover);
    color: var(--paper);
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg) var(--space-2xl);
    margin: 0;
  }

  .hero-stats dt {
    font-family: var(--face-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--ink-faint);
  }

  .hero-stats dd {
    margin: 0;
    font-family: var(--face-display);
    font-size: var(--text-2xl);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
  }

  .section-head .label {
    flex: 1;
  }

  .section-more {
    font-family: var(--face-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .recent,
  .regions {
    margin-block-start: var(--space-xl);
  }

  /*
   * The atlas index plate — the signature device. A ruled table of entries,
   * each carrying its plate reference, framed like a printed plate in an atlas.
   */
  .atlas-plate {
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
    border: var(--hairline) solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--paper-raised);
  }

  .atlas-entry {
    display: grid;
    grid-template-columns: 5rem 1fr auto;
    gap: var(--space-sm);
    align-items: baseline;
    padding: var(--space-sm) var(--space-md);
    border-block-start: var(--hairline) solid var(--rule);
  }

  .atlas-entry:first-child {
    border-block-start: 0;
  }

  .atlas-entry:nth-child(even) {
    background: rgb(16 24 35 / 2%);
  }

  .atlas-entry-ref {
    color: var(--gold-rule);
  }

  .atlas-entry-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    min-inline-size: 0;
  }

  .atlas-entry-title {
    font-family: var(--face-display);
    font-weight: 500;
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--ink);
    text-decoration: none;
  }

  .atlas-entry-title:hover {
    color: var(--action-hover);
    text-decoration: underline;
  }

  .atlas-entry-meta {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .atlas-entry-year {
    font-family: var(--face-mono);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
  }

  .region-grid {
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--space-xs);
  }

  .region-tile {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: var(--space-xs);
    padding: var(--space-sm);
    min-block-size: 2.75rem;
    border: var(--hairline) solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-raised);
    text-decoration: none;
    color: var(--ink);
    transition: border-color var(--duration) var(--ease);
  }

  .region-tile:hover {
    border-color: var(--action);
    color: var(--ink);
  }

  .region-tile-code {
    font-family: var(--face-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-plate);
    color: var(--gold-rule);
  }

  .region-tile-name {
    font-size: var(--text-sm);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .region-tile-count {
    font-family: var(--face-mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  .consent-note {
    margin-block-start: var(--space-2xl);
  }

  .consent-inner {
    padding-block-start: var(--space-lg);
  }

  .empty {
    padding-block: var(--space-xl);
    color: var(--ink-muted);
  }

  @media (max-width: 32rem) {
    .atlas-entry {
      grid-template-columns: 1fr auto;
    }

    .atlas-entry-ref {
      grid-column: 1 / -1;
    }
  }
</style>
