---
/*
 * Pagefind search.
 *
 * The index is built by `pagefind --site dist` in the postbuild step, so
 * /pagefind/pagefind.js only exists in a production build — in `astro dev`
 * the page degrades to an explanatory message instead of a broken widget.
 *
 * The header form posts here with ?q=, so search works as plain navigation
 * before any JavaScript runs. This page then reads the query and runs it.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_NAME } from "../../site.config.ts";
---

<BaseLayout title="Search" description={`Search the ${SITE_NAME} archive.`}>
  <div class="page search">
    <p class="label">Search</p>
    <h1>Search the archive</h1>

    <form class="search-form" role="search" action="/search/" method="get">
      <label class="visually-hidden" for="q">Search query</label>
      <input
        id="q"
        type="search"
        name="q"
        placeholder="Talk title, researcher, tool, CVE…"
        autocomplete="off"
        spellcheck="false"
        autofocus
      />
      <button type="submit">Search</button>
    </form>

    <p class="search-status" role="status" aria-live="polite" data-search-status></p>

    <ol class="search-results" data-search-results></ol>

    <noscript>
      <p class="search-note">
        Search needs JavaScript. You can still browse the full
        <a href="/works/">works index</a>, <a href="/people/">people index</a>,
        and <a href="/events/">event landscape</a> without it.
      </p>
    </noscript>
  </div>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>("#q");
  const status = document.querySelector<HTMLElement>("[data-search-status]");
  const results = document.querySelector<HTMLElement>("[data-search-results]");

  interface PagefindResultData {
    url: string;
    excerpt: string;
    meta?: Record<string, string>;
  }
  interface PagefindApi {
    init(): Promise<void>;
    debouncedSearch(
      term: string,
      options?: unknown,
      timeout?: number,
    ): Promise<{ results: { id: string; data(): Promise<PagefindResultData> }[] } | null>;
  }

  let pagefind: PagefindApi | null = null;
  let loadFailed = false;

  async function getPagefind(): Promise<PagefindApi | null> {
    if (pagefind || loadFailed) return pagefind;
    try {
      // Neither Vite nor TypeScript may resolve this at build time — the file
      // is generated by Pagefind in postbuild, after Astro has finished. A
      // non-literal specifier keeps both of them out of it.
      const modulePath = "/pagefind/pagefind.js";
      pagefind = (await import(/* @vite-ignore */ modulePath)) as PagefindApi;
      await pagefind.init();
    } catch {
      loadFailed = true;
      pagefind = null;
    }
    return pagefind;
  }

  function escapeHtml(value: string): string {
    return value.replace(
      /[&<>"']/g,
      (char) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char] ?? char,
    );
  }

  async function run(term: string) {
    if (!status || !results) return;

    if (!term.trim()) {
      status.textContent = "";
      results.replaceChildren();
      return;
    }

    const api = await getPagefind();
    if (!api) {
      status.textContent =
        "The search index is only built in production. Run `npm run build` and preview the site to search locally.";
      return;
    }

    status.textContent = "Searching…";
    const search = await api.debouncedSearch(term);
    // A newer keystroke superseded this query.
    if (search === null) return;

    const found = await Promise.all(search.results.slice(0, 30).map((r) => r.data()));

    status.textContent =
      found.length === 0
        ? `No entries match “${term}”.`
        : `${found.length}${search.results.length > found.length ? "+" : ""} ${
            found.length === 1 ? "entry" : "entries"
          } for “${term}”.`;

    results.innerHTML = found
      .map((result) => {
        const title = escapeHtml(result.meta?.title ?? result.url);
        // Pagefind's excerpt contains its own <mark> tags and is escaped by
        // Pagefind itself; everything else is escaped here.
        return `<li class="search-result">
            <a class="search-result-title" href="${escapeHtml(result.url)}">${title}</a>
            <p class="search-result-excerpt">${result.excerpt}</p>
          </li>`;
      })
      .join("");
  }

  if (input) {
    const initial = new URLSearchParams(location.search).get("q") ?? "";
    if (initial) {
      input.value = initial;
      void run(initial);
    }

    input.addEventListener("input", () => void run(input.value));

    // Keep the URL shareable without a full navigation.
    input.form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const query = input.value;
      history.replaceState(null, "", query ? `?q=${encodeURIComponent(query)}` : location.pathname);
      void run(query);
    });
  }
</script>

<style>
  .search {
    max-inline-size: 48rem;
  }

  .search-form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-block: var(--space-lg);
  }

  .search-form input {
    flex: 1 1 16rem;
    min-inline-size: 0;
    font-family: var(--face-body);
    font-size: var(--text-base);
    padding: var(--space-xs) var(--space-sm);
    min-block-size: 2.75rem;
    background: var(--paper-raised);
    border: var(--hairline) solid var(--rule-strong);
    border-radius: var(--radius);
    color: var(--ink);
  }

  .search-form button {
    font-family: var(--face-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-plate);
    padding: var(--space-xs) var(--space-lg);
    min-block-size: 2.75rem;
    background: var(--action);
    color: var(--paper);
    border: 0;
    border-radius: var(--radius);
    cursor: pointer;
    transition: background-color var(--duration) var(--ease);
  }

  .search-form button:hover {
    background: var(--action-hover);
  }

  .search-status {
    font-family: var(--face-mono);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    min-block-size: 1.5em;
  }

  .search-results {
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
  }

  .search-results :global(.search-result) {
    padding-block: var(--space-md);
    border-block-start: var(--hairline) solid var(--rule);
  }

  .search-results :global(.search-result-title) {
    font-family: var(--face-display);
    font-weight: 500;
    font-size: var(--text-lg);
    color: var(--ink);
    text-decoration: none;
  }

  .search-results :global(.search-result-title:hover) {
    color: var(--action-hover);
    text-decoration: underline;
  }

  .search-results :global(.search-result-excerpt) {
    margin-block: var(--space-2xs) 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  .search-results :global(mark) {
    background: rgb(201 162 39 / 30%);
    color: var(--ink);
    padding: 0 0.1em;
  }

  .search-note {
    color: var(--ink-muted);
  }
</style>
