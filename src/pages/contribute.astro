---
/*
 * PHASE 1 STUB.
 *
 * Phase 2 replaces the two sections below with real forms that generate a
 * pre-filled GitHub PR (and a mailto fallback for people without a GitHub
 * account). This page exists now because /people/<slug>/ links here for the
 * claim flow and the footer links here from every page — a 404 behind the
 * claim CTA would break the one action an unclaimed profile offers.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { dataDirUrl, SITE_NAME, SITE_REPO, SITE_REPO_URL } from "../../site.config.ts";

const description = `Add a work to ${SITE_NAME}, or claim your researcher profile.`;
---

<BaseLayout title="Contribute" description={description}>
  <div class="page contribute">
    <header>
      <p class="label">Contribute</p>
      <h1>Add to the archive</h1>
      <p class="prose lede">
        Two funnels: add a work that belongs in the index, or claim the profile
        that already carries your name.
      </p>
      <p class="prose repo-note">
        Everything on this site is generated from YAML in
        <a href={SITE_REPO_URL} rel="noopener external">{SITE_REPO}</a>. There is
        no database and no admin panel — a contribution is a pull request, and a
        correction is a one-line diff.
      </p>
    </header>

    <div class="meridian"></div>

    <section class="funnel prose" id="work">
      <h2>Add a work</h2>
      <p>
        A talk, tool, CVE, paper, workshop, or write-up from the region. You do
        not need to be the author — accurate public metadata from anyone is
        welcome.
      </p>
      <p>What we record: title, type, year, author names, event, links, tags.</p>
      <p class="funnel-note">
        The guided form arrives in the next release. Until then, add a YAML file
        to <a href={dataDirUrl("data/works")} rel="noopener external"><code>data/works/</code></a>
        following
        <a href={`${SITE_REPO_URL}/blob/main/data/schema/work.schema.json`} rel="noopener external">
          <code>work.schema.json</code></a>, and open a pull request. CI validates
        every entry, so you will know within a minute if a field is wrong.
      </p>
    </section>

    <section class="funnel prose" id="claim">
      <h2>Claim your profile</h2>
      <p>
        If your name appears in the index, your entry currently shows only that
        name, an optional country, and your linked works. Claiming lets you add
        a biography, links, an Arabic-script name, and a photo — and nothing is
        added that you do not supply yourself.
      </p>
      <p>
        To verify a claim we need proof that you control an identity already
        publicly tied to the work: a post from a linked account, a DNS TXT
        record, a file on your own site, or confirmation from an email address
        published in the original work.
        <a href="/about/#claim-verification">Full verification methods.</a>
      </p>
      <p class="funnel-note">
        The guided claim form arrives in the next release. Until then, edit your
        entry in
        <a href={dataDirUrl("data/people")} rel="noopener external"><code>data/people/</code></a>
        — set <code>claimed: true</code> and add what you want shown — and open a
        pull request. Your entry page links directly to its own file.
      </p>

      <aside class="removal-callout">
        <p>
          <strong>Would you rather not be listed at all?</strong> That is an
          equally valid answer, and it needs no explanation.
          <a href="/about/#removal">Request removal</a> — honoured within seven
          days, without debate.
        </p>
      </aside>
    </section>
  </div>
</BaseLayout>

<style>
  .contribute {
    max-inline-size: 48rem;
  }

  .lede {
    font-size: var(--text-lg);
    color: var(--ink-muted);
  }

  .funnel {
    margin-block-start: var(--space-xl);
    scroll-margin-block-start: var(--space-lg);
  }

  h2 {
    font-size: var(--text-xl);
  }

  .repo-note {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    margin-block-start: var(--space-md);
  }

  .funnel-note {
    border-inline-start: 2px solid var(--gold-rule);
    padding-inline-start: var(--space-sm);
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  .removal-callout {
    margin-block-start: var(--space-lg);
    padding: var(--space-md);
    background: var(--paper-raised);
    border: var(--hairline) solid var(--rule);
    border-radius: var(--radius);
  }

  .removal-callout p {
    margin: 0;
    font-size: var(--text-sm);
  }
</style>
